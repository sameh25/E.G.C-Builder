+
+      true
+    rescue StandardError
+      false
+    end
+
+    def rotatable?(row, mat, lock)
+      return false if lock[mat] == true # explicit project lock
+      return true if lock[mat] == false # explicit project unlock
+
+      grain_free?(mat, row[:mat_code])
+    end
